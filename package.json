{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "description": "End-to-end UI automation for SauceDemo using Playwright, JavaScript and the Page Object Model",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:sanity": "playwright test --project=chromium --grep @sanity",
    "test:regression": "playwright test --project=chromium --grep @regression",
    "test:all-browsers": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --project=chromium --ui",
    "test:list": "playwright test --project=chromium --list",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
